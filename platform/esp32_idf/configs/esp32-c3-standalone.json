{
  "config_version": 1,
  "control_period_ms": 100,

  "sensors": [
    {
      "id": 0,
      "name": "soc",
      "iir_alpha_q16": 16384,
      "max_staleness_ms": 5000
    }
  ],

  "context_signals": [],

  "actuators": [
    {
      "id": 0,
      "name": "main_fan",
      "pwm_min": 0,
      "pwm_max": 255,
      "slew_per_tick": 8,
      "spinup_pwm": 0,
      "spinup_ms": 0,
      "state_pwm": [0, 100, 160, 220, 255]
    }
  ],

  "zones": [
    {
      "name": "soc_zone",
      "sensors": ["soc"],
      "aggregation": "max",
      "fallback_temp_mc": 85000,
      "governor": "step_wise",
      "actuators": ["main_fan"],
      "trips": [
        { "temp_mc": 30000, "hyst_mc": 2000, "severity": "warn",     "cooling_state": 1 },
        { "temp_mc": 45000, "hyst_mc": 2000, "severity": "warn",     "cooling_state": 2 },
        { "temp_mc": 60000, "hyst_mc": 2000, "severity": "critical", "cooling_state": 3 }
      ]
    }
  ],

  "policy_modifiers": [],

  "fault_detection": {},

  "telemetry": {
    "enable": true,
    "period_ticks": 10,
    "signals": ["zone_temp_*", "actuator_pwm_*"],
    "transport": "uart:console"
  },

  "control": {
    "listen": "",
    "enable": false
  },

  "mcu_pinmap": {
    "sensors": [
      { "name": "soc", "onewire_gpio": 6 }
    ],
    "actuators": [
      { "name": "main_fan", "pwm_gpio": 4, "tach_gpio": 5, "pwm_freq_hz": 25000 }
    ]
  }
}
