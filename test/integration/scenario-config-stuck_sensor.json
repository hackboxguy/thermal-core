{
  "config_version": 1,
  "control_period_ms": 100,

  "sensors": [
    {
      "id": 0,
      "name": "soc",
      "iir_alpha_q16": 16384,
      "max_staleness_ms": 500,
      "source": "/tmp/thermal-core-scenario/sensors/soc"
    }
  ],

  "context_signals": [
    {
      "id": 0,
      "name": "vehicle_speed",
      "unit": "kmh",
      "iir_alpha_q16": 2048,
      "timeout_ms": 3000,
      "fail_safe": "assume_stationary",
      "source": "/tmp/thermal-core-scenario/contexts/vehicle_speed"
    }
  ],

  "actuators": [
    {
      "id": 0,
      "name": "main_fan",
      "pwm_min": 0,
      "pwm_max": 255,
      "slew_per_tick": 64,
      "spinup_pwm": 0,
      "spinup_ms": 0,
      "state_pwm": [0, 100, 160, 220, 255],
      "pwm": "/tmp/thermal-core-scenario/pwm1",
      "tach": "/tmp/thermal-core-scenario/fan1_input",
      "pwm_freq_hz": 25000,
      "tach_pulses_per_rev": 2
    }
  ],

  "zones": [
    {
      "name": "soc_zone",
      "sensors": ["soc"],
      "aggregation": "max",
      "fallback_temp_mc": 90000,
      "governor": "step_wise",
      "actuators": ["main_fan"],
      "trips": [
        { "temp_mc": 70000, "hyst_mc": 2000, "severity": "warn",     "cooling_state": 1 },
        { "temp_mc": 90000, "hyst_mc": 2000, "severity": "critical", "cooling_state": 3 }
      ]
    }
  ],

  "policy_modifiers": [],

  "fault_detection": {
    "stuck_sensor": {
      "enabled": true,
      "severity": "degraded",
      "action": "use_zone_fallback",
      "persist_ticks": 1,
      "recovery_ticks": 10,
      "delta_mc": 100,
      "window_ticks": 50,
      "correlated_context": "vehicle_speed"
    }
  },

  "telemetry": {
    "enable": true,
    "period_ticks": 1,
    "signals": ["zone_temp_*", "actuator_pwm_*", "fault_*"],
    "transport": "udp:127.0.0.1:9034"
  },

  "control": {
    "listen": "",
    "enable": false
  }
}
