{
  "config_version": 1,
  "control_period_ms": 100,

  "sensors": [
    {
      "id": 0,
      "name": "soc",
      "iir_alpha_q16": 16384,
      "max_staleness_ms": 500,
      "source": "/tmp/thermal-core-pid-integ/sensors/soc"
    }
  ],

  "context_signals": [
    {
      "id": 0,
      "name": "vehicle_speed",
      "unit": "kmh",
      "iir_alpha_q16": 2048,
      "timeout_ms": 3000,
      "fail_safe": "assume_stationary",
      "source": "/tmp/thermal-core-pid-integ/contexts/vehicle_speed"
    }
  ],

  "actuators": [
    {
      "id": 0,
      "name": "main_fan",
      "pwm_min": 0,
      "pwm_max": 255,
      "slew_per_tick": 64,
      "spinup_pwm": 0,
      "spinup_ms": 0,
      "state_pwm": [0, 100, 160, 220, 255],
      "pwm": "/tmp/thermal-core-pid-integ/pwm1",
      "tach": "/tmp/thermal-core-pid-integ/fan1_input",
      "pwm_freq_hz": 25000,
      "tach_pulses_per_rev": 2
    }
  ],

  "zones": [
    {
      "name": "soc_zone",
      "sensors": ["soc"],
      "aggregation": "max",
      "fallback_temp_mc": 85000,
      "governor": "pid",
      "actuators": ["main_fan"],
      "pid": {
        "kp_q16": 4915,
        "ki_q16": 327,
        "kd_q16": 0,
        "setpoint_mc": 75000,
        "kp_min_q16": 0,
        "kp_max_q16": 327680,
        "ki_min_q16": 0,
        "ki_max_q16": 65536,
        "kd_min_q16": 0,
        "kd_max_q16": 65536,
        "setpoint_min_mc": 50000,
        "setpoint_max_mc": 95000,
        "dt_min_ms": 50,
        "dt_max_ms": 500
      },
      "trips": [
        { "temp_mc": 90000, "hyst_mc": 2000, "severity": "critical", "cooling_state": 3 }
      ]
    }
  ],

  "policy_modifiers": [],

  "fault_detection": {},

  "telemetry": {
    "enable": true,
    "period_ticks": 1,
    "signals": ["zone_temp_*", "actuator_pwm_*", "pid_terms_*"],
    "transport": "udp:127.0.0.1:9010"
  },

  "control": {
    "listen": "udp:127.0.0.1:9012",
    "enable": true
  }
}
