# scenarios/can_bus_loss.scn
#
# PRD section 9.1 row 10: "Cut CAN; verify fail-safe to
# assume_stationary after the configured context timeout_ms."
#
# Plant runs in critical for the duration.  The bus-loss
# fail_safe correctly flips the modifier's effective speed to 0
# after timeout_ms (cap = curve(0) = 180), BUT the cap is then
# bypassed because zone severity is critical (PRD section 4.6
# lines 598/625/654 -- "Affected actuators bypass acoustic
# caps").  So PWM stays at state_pwm[3] = 220 throughout, and
# the post-loss "PWM clamped to <= 200" check that earlier
# revisions encoded can't be satisfied at this trip schedule.
#
# What this scenario still exercises:
#   - emulator startup + speed broadcast on vcan0
#   - daemon's CAN BSP timeout cascade after kill_emulator
#   - critical-state PWM target (>= 220) before and during loss
# Bus-loss fail_safe behaviour at non-critical severity is
# tested in test/integration/test_canbus_busloss.py against the
# TSIG_CONTEXT_VALUE_0 telemetry signal directly (where the cap
# bypass doesn't apply because there's no thermal trip in play).

config test/integration/scenario-config-canbus.json

plant ambient_mc      50000
plant initial_temp_mc 92000
plant duration_ms     20000

# Speed = 100 km/h -> high-speed cap = 255 (no clipping).
0     set_emulator_speed 100

# Cut CAN at t=10 s -- triggers the BSP timeout cascade, but
# the critical-state PWM target stays unchanged because critical
# bypasses caps.
10000 kill_emulator

# PWM rises to >= 220 (critical state) well within the pre-loss
# window and stays there.
assert eventually actuator_pwm 0 >= 220 within 8000

assert no_faults
