# scenarios/acoustic_mask_high_speed.scn
#
# PRD section 9.1 row 7: "Vehicle speed sweep 0 -> 130 km/h;
# verify cap releases, trip offset applied."
#
# Plant runs in the critical band (above 90000 mc).  At critical
# severity the acoustic_mask cap is **intentionally bypassed**
# per PRD section 4.6 lines 598, 625, 654 ("Affected actuators
# bypass acoustic caps").  So PWM reaches state_pwm[3] = 220
# regardless of speed.  This scenario exercises the speed-sweep
# code path + verifies the critical-state target is reached;
# the cap-release-with-speed behaviour itself can't be
# uniquely-tested at the current trip schedule (state_pwm[1]=100
# is below cap=180, so the cap is informational below critical,
# and bypassed above).  See acoustic_mask_low_speed.scn for the
# low-speed-cap-informational case.

config test/integration/scenario-config-canbus.json

plant ambient_mc      50000
plant initial_temp_mc 92000
plant duration_ms     30000

# Speed sweep -- modifier curve evaluation runs, just doesn't
# clip PWM since the zone is critical the whole time.
0     set_emulator_speed 0
10000 set_emulator_speed 50
20000 set_emulator_speed 130

# Critical trip drives PWM up to state_pwm[3] = 220.  Filter
# time constant ~1.5 s; allow generous settle window.
assert eventually actuator_pwm 0 >= 220 within 30000

assert no_faults
